# OpenCEX RPC Router – copy to .env and fill

# --- Primary providers (pick at least 2) ---
DRPC_API_KEY=
ANKR_API_KEY=
GROVE_APP_ID=
GROVE_API_KEY=
LAVA_API_KEY=
GETBLOCK_API_KEY=
NOWNODES_API_KEY=

# --- Toggles ---
USE_1RPC=true
USE_PUBLIC_RPCS=true

# --- Optional full URL overrides (comma-separated) ---
# RPC_ETH_URLS=https://...,https://...
# RPC_BNB_URLS=
# RPC_POLYGON_URLS=
# RPC_ARBITRUM_URLS=
# RPC_BASE_URLS=
